generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  engineType      = "esm"
  previewFeatures = ["relationJoins"]
}

datasource db {
  provider = "postgres"
  url      = env("DATABASE_URL")
}

enum Role {
  STUDENT
  STAFF
  ADMIN
}

model Course {
  id                 String   @id // User-provided id
  githubOrg          String
  githubRepoPrefix   String
  githubToken        String
  // GitHub team slug granted (maintain) access to on-demand project repos.
  // Null falls back to the legacy `${githubRepoPrefix}_staff-team` convention.
  staffTeamSlug      String?
  name               String
  jenkinsToken       String
  feedbackBranchName String
  courseCutoff       DateTime
  jenkinsBaseUrl     String
  courseTimezone     String
  gradesRepo         String
  rosterRepo         String
  firstLabDate       DateTime

  // PrairieLearn integration (nullable until configured via applyGradingConfig.ts)
  prairieLearnApiToken         String?
  prairieLearnBaseUrl          String?
  prairieLearnCourseInstanceId String?
  prairieLearnLastSyncedAt     DateTime?

  // Extensions config
  numExtensions     Int
  numExtensionHours Int

  // Relations
  users                 Users[]
  Job                   Job[]
  Assignment            Assignment[]
  StagingGrades         StagingGrades[]
  PublishedGrades       PublishedGrades[]
  Extensions            Extensions[]
  ExtensionUsageHistory ExtensionUsageHistory[]
  AttendanceRecord      AttendanceRecord[]
  PartnerGroup          PartnerGroup[]
  GradingCategoryConfig GradingCategoryConfig[]
  GithubUsernameMapping GithubUsernameMapping[]
  ProjectRepoPool       ProjectRepoPool[]
  ProjectRepoAssignment ProjectRepoAssignment[]
  ProjectRepoConfig     ProjectRepoConfig[]
  GradeAuditLog         GradeAuditLog[]
  InterviewClinic       InterviewClinic[]
}

model Users {
  netId      String
  role       Role
  courseId   String
  enabled    Boolean @default(true)
  course     Course  @relation(fields: [courseId], references: [id], onDelete: Cascade)
  uin        String?
  name       String?
  labSection String?

  Grades                PublishedGrades[]
  StagingGrades         StagingGrades[]
  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @updatedAt
  Extensions            Extensions[]
  Job                   Job[]
  ExtensionUsageHistory ExtensionUsageHistory[]
  AttendanceRecord      AttendanceRecord[]
  PartnerGroupMember    PartnerGroupMember[]
  GithubUsernameMapping GithubUsernameMapping[]
  ProjectRepoAssignment ProjectRepoAssignment[]
  GradeAuditLog         GradeAuditLog[]

  @@id([netId, courseId]) // Composite primary key
  @@unique([courseId, uin])
  @@index([netId, enabled])
  @@index([courseId, netId, enabled])
  @@index([courseId, uin, enabled])
}

enum JobStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
  INFRA_ERROR
  TIMEOUT
}

enum JobType {
  STUDENT_INITIATED
  FINAL_GRADING
  REGRADE
  STAFF_INITIATED
  STAFF_INITIATED_GRADING
  PARTNER_ROTATION
}

enum AssignmentVisibility {
  DEFAULT
  FORCE_OPEN
  FORCE_CLOSE
  INVISIBLE_FORCE_CLOSE
}

enum AssignmentQuota {
  DAILY
  TOTAL
}

enum Category {
  LAB
  MP
  ATTENDANCE
  BONUS
  FINAL
  OTHER
  PRAIRIELEARN
  PROJECT
}

enum AutogradableCategory {
  LAB
  MP
  PROJECT
}

enum GradingMode {
  AUTOGRADED
  MANUAL
}

model Assignment {
  id                String
  name              String
  courseId          String
  visibility        AssignmentVisibility
  quotaPeriod       AssignmentQuota
  category          Category
  studentExtendable Boolean

  jenkinsPipelineName      String?
  quotaAmount              Int
  finalGradingRunId        String?
  partnerRoundNumber       Int? // 1-4. LAB or PROJECT category only. null = this assignment doesn't use partners.
  weight                   Float                   @default(0) // gradebook weight (points toward final grade)
  prairieLearnAssessmentId String? // set for PrairieLearn-synced assignments only
  projectKey               String? // groups the autograded + manual rows of the same logical project; PROJECT-only (CHECK enforced in DB)
  gradingMode              GradingMode             @default(MANUAL) // AUTOGRADED if Jenkins, MANUAL if staff-graded
  openAt                   DateTime
  createdAt                DateTime                @default(now())
  updatedAt                DateTime                @updatedAt
  Job                      Job[]
  Course                   Course                  @relation(fields: [courseId], references: [id], onDelete: Cascade)
  PublishedGrades          PublishedGrades[]
  Extensions               Extensions[]
  ExtensionUsageHistory    ExtensionUsageHistory[]
  AttendanceRecord         AttendanceRecord[]
  GradeAuditLog            GradeAuditLog[]

  @@id([courseId, id]) // Composite primary key
  @@unique([courseId, prairieLearnAssessmentId])
  @@index([courseId, visibility])
  @@index([courseId, category, projectKey])
}

model Job {
  id                   String                @id @default(cuid())
  name                 String
  courseId             String
  course               Course                @relation(fields: [courseId], references: [id], onDelete: Cascade)
  assignmentId         String
  netId                String[]
  type                 JobType
  autogradableCategory AutogradableCategory? // a workaround just to get the enum to be generated
  buildUrl             String?
  queueUrl             String?

  dueAt              DateTime
  isScheduledJob     Boolean         @default(false)
  scheduledAt        DateTime?
  startedAt          DateTime?
  status             JobStatus       @default(PENDING)
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  failedAt           DateTime?
  StagingGrades      StagingGrades[]
  Extensions         Extensions[]
  Assignment         Assignment?     @relation(fields: [assignmentCourseId, assignmentId], references: [courseId, id], onDelete: Cascade)
  assignmentCourseId String?
  Users              Users?          @relation(fields: [usersNetId, usersCourseId], references: [netId, courseId])
  usersNetId         String?
  usersCourseId      String?

  @@index([status, scheduledAt])
  @@index([status, createdAt])
  @@index([name, status])
  @@index([netId, courseId, assignmentId, type]) // get user runs call
}

model PublishedGrades {
  courseId     String
  assignmentId String
  netId        String
  course       Course     @relation(fields: [courseId], references: [id], onDelete: Cascade)
  assignment   Assignment @relation(fields: [courseId, assignmentId], references: [courseId, id], onDelete: NoAction)
  comments     String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  score        Float
  Users        Users      @relation(fields: [netId, courseId], references: [netId, courseId])

  @@id([courseId, assignmentId, netId])
  @@index([courseId, assignmentId])
  @@index([courseId, netId])
}

model StagingGrades {
  jobId    String
  netId    String
  score    Float
  comments String?

  gradingJob Job      @relation(fields: [jobId], references: [id], onDelete: NoAction)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  Course     Course?  @relation(fields: [courseId], references: [id], onDelete: Cascade)
  courseId   String
  Users      Users    @relation(fields: [netId, courseId], references: [netId, courseId])

  @@id([jobId, netId])
  @@index([jobId])
}

enum ExtensionInitiator {
  STUDENT
  STAFF
  STUDENT_EXEMPT // A NQE created by the student but which has been exempted from the cap
}

model Extensions {
  id                String             @id @default(cuid())
  courseId          String
  assignmentId      String
  netId             String
  quotaAmount       Int
  finalGradingRunId String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  createdBy         String
  extensionType     ExtensionInitiator

  quotaPeriod           AssignmentQuota
  Course                Course                  @relation(fields: [courseId], references: [id], onDelete: Cascade)
  Users                 Users                   @relation(fields: [netId, courseId], references: [netId, courseId])
  Assignment            Assignment              @relation(fields: [assignmentId, courseId], references: [id, courseId], onDelete: Cascade)
  GradingJob            Job?                    @relation(fields: [finalGradingRunId], references: [id], onDelete: Cascade)
  openAt                DateTime
  closeAt               DateTime
  ExtensionUsageHistory ExtensionUsageHistory[]

  @@index([courseId, assignmentId, netId])
}

model ExtensionUsageHistory {
  extensionId  String
  courseId     String
  assignmentId String
  netId        String
  Course       Course     @relation(fields: [courseId], references: [id], onDelete: Cascade)
  Users        Users      @relation(fields: [netId, courseId], references: [netId, courseId])
  Assignment   Assignment @relation(fields: [assignmentId, courseId], references: [id, courseId])
  Extension    Extensions @relation(fields: [extensionId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@id([extensionId, courseId, assignmentId, netId, createdAt])
}

model AttendanceRecord {
  courseId  String
  weekId    Int
  netId     String
  submitted Boolean

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String

  Course             Course      @relation(fields: [courseId], references: [id], onDelete: Cascade)
  Users              Users       @relation(fields: [netId, courseId], references: [netId, courseId])
  Assignment         Assignment? @relation(fields: [assignmentCourseId, assignmentId], references: [courseId, id])
  assignmentCourseId String?
  assignmentId       String?

  @@id([courseId, weekId, netId])
  @@index([courseId, weekId, createdBy])
}

model PartnerGroup {
  id          String @id @default(cuid())
  courseId    String
  labSection  String
  roundNumber Int
  createdBy   String // netId of the staff editor, admin who (re)generated it, or "system-import" for the historical backfill script

  archivedAt DateTime? // null = currently active group for this (courseId, labSection, roundNumber)
  archivedBy String? // who triggered the replacement that archived this row

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  Course                Course                  @relation(fields: [courseId], references: [id], onDelete: Cascade)
  members               PartnerGroupMember[]
  ProjectRepoAssignment ProjectRepoAssignment[]

  @@index([courseId, labSection, roundNumber, archivedAt])
}

model PartnerGroupMember {
  id             String @id @default(cuid())
  courseId       String
  netId          String
  roundNumber    Int
  partnerGroupId String

  PartnerGroup PartnerGroup @relation(fields: [partnerGroupId], references: [id], onDelete: Cascade)
  Users        Users        @relation(fields: [netId, courseId], references: [netId, courseId])

  @@unique([partnerGroupId, netId])
  @@index([courseId, netId, roundNumber])
}

model GradingCategoryConfig {
  courseId   String
  category   Category
  dropLowest Int      @default(0)

  Course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@id([courseId, category])
}

model GithubUsernameMapping {
  courseId       String
  netId          String
  githubUsername String
  githubName     String?
  minedAt        DateTime @default(now())

  Course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  Users  Users  @relation(fields: [netId, courseId], references: [netId, courseId])

  @@id([courseId, netId])
  @@unique([courseId, githubUsername])
}

model ProjectRepoPool {
  id            String    @id @default(cuid())
  courseId      String
  projectKey    String
  repoName      String
  sortOrder     Int
  createdAt     DateTime  @default(now())
  // Null = the repo has not been created on GitHub yet (on-demand projects
  // only; pool imports set it immediately since those repos exist out-of-band).
  provisionedAt DateTime?

  Course      Course                  @relation(fields: [courseId], references: [id], onDelete: Cascade)
  assignments ProjectRepoAssignment[]

  @@unique([courseId, projectKey, repoName])
  @@unique([courseId, projectKey, sortOrder])
  @@index([courseId, projectKey, sortOrder])
}

// Per-project provisioning configuration. One logical project (identified by
// projectKey) spans several Assignment rows; this holds the settings once.
model ProjectRepoConfig {
  courseId        String
  projectKey      String
  repoMode        ProjectRepoMode @default(POOL)
  // Used to build on-demand repo names: {githubRepoPrefix}_.{repoProjectName}_.team-{NNN}
  repoProjectName String?
  // GitHub org where this project's repos live (on-demand creation, cloning,
  // collaborator sync, student-facing URLs). Null falls back to
  // Course.githubOrg - which stays correct for legacy POOL projects.
  githubOrg       String?

  Course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@id([courseId, projectKey])
}

enum ProjectRepoMode {
  POOL
  ON_DEMAND
}

model ProjectRepoAssignment {
  id                    String    @id @default(cuid())
  courseId              String
  projectKey            String
  netId                 String
  repoName              String
  assignedAt            DateTime  @default(now())
  assignedBy            String
  sourcePartnerGroupId  String?
  releasedAt            DateTime?
  releasedBy            String?
  // Sync-derived tri-state: confirmed = observed as actual collaborator;
  // inviteSentAt = invitation open on GitHub, awaiting acceptance.
  // Both null/unset = never invited (no mapping, sync not run, or send failed).
  githubAccessConfirmed Boolean   @default(false)
  githubInviteSentAt    DateTime?

  Course             Course          @relation(fields: [courseId], references: [id], onDelete: Cascade)
  Users              Users           @relation(fields: [netId, courseId], references: [netId, courseId], onDelete: NoAction)
  ProjectRepoPool    ProjectRepoPool @relation(fields: [courseId, projectKey, repoName], references: [courseId, projectKey, repoName], onDelete: Restrict)
  sourcePartnerGroup PartnerGroup?   @relation(fields: [sourcePartnerGroupId], references: [id], onDelete: SetNull)

  @@index([courseId, projectKey, netId])
  @@index([courseId, projectKey, repoName])
}

model ProjectRepoAssignmentAuditLog {
  id          String   @id @default(cuid())
  courseId    String
  projectKey  String
  netId       String
  oldRepoName String?
  newRepoName String?
  action      String
  actor       String
  at          DateTime @default(now())
  reason      String?

  @@index([courseId, projectKey, netId])
}

model GradeAuditLog {
  id            String   @id @default(cuid())
  courseId      String
  assignmentId  String
  netId         String
  oldScore      Float?
  newScore      Float?
  oldComments   String?
  newComments   String?
  changedBy     String
  changedAt     DateTime @default(now())
  justification String?

  Course     Course     @relation(fields: [courseId], references: [id], onDelete: Cascade)
  Assignment Assignment @relation(fields: [courseId, assignmentId], references: [courseId, id], onDelete: Cascade)
  Users      Users      @relation(fields: [netId, courseId], references: [netId, courseId], onDelete: NoAction)

  @@index([courseId, assignmentId, netId])
}

// Interview clinics: instructors book rooms (ClinicRoomBlock), which are split
// into 30-minute ClinicSlots. CAs claim slots they will cover; project repo
// teams book a claimed slot, which creates an Outlook event on the CA's
// calendar with the team as attendees.
model InterviewClinic {
  id            String    @id @default(cuid())
  courseId      String
  projectKey    String
  title         String
  description   String?
  signupOpensAt DateTime?
  createdBy     String
  createdAt     DateTime  @default(now())
  archivedAt    DateTime?

  Course     Course            @relation(fields: [courseId], references: [id], onDelete: Cascade)
  roomBlocks ClinicRoomBlock[]
  slots      ClinicSlot[]
  bookings   ClinicBooking[]

  @@index([courseId, archivedAt])
}

model ClinicRoomBlock {
  id        String   @id @default(cuid())
  clinicId  String
  room      String // Free text; used as the Outlook event location
  startAt   DateTime
  endAt     DateTime
  createdBy String
  createdAt DateTime @default(now())

  InterviewClinic InterviewClinic @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  slots           ClinicSlot[]

  @@index([clinicId])
}

model ClinicSlot {
  id          String    @id @default(cuid())
  clinicId    String
  roomBlockId String
  startAt     DateTime
  endAt       DateTime
  caNetId     String? // CA covering this slot; null = unclaimed
  claimedAt   DateTime?

  InterviewClinic InterviewClinic @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  ClinicRoomBlock ClinicRoomBlock @relation(fields: [roomBlockId], references: [id], onDelete: Cascade)
  bookings        ClinicBooking[]

  @@unique([roomBlockId, startAt])
  @@index([clinicId, startAt])
}

enum ClinicCalendarStatus {
  PENDING
  CREATED
  FAILED
  CANCELLED
}

model ClinicBooking {
  id             String    @id @default(cuid())
  clinicId       String
  slotId         String
  projectKey     String
  repoName       String
  attendeeNetIds String[] // Team snapshot at booking time
  bookedBy       String
  bookedAt       DateTime  @default(now())
  cancelledAt    DateTime? // null = active
  cancelledBy    String?

  outlookEventId String?
  organizerNetId String?
  calendarStatus ClinicCalendarStatus @default(PENDING)
  calendarError  String?

  InterviewClinic InterviewClinic @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  ClinicSlot      ClinicSlot      @relation(fields: [slotId], references: [id], onDelete: Cascade)

  // Partial unique indexes (one active booking per slot, one active booking
  // per team per clinic) live in the migration SQL since Prisma can't model them.
  @@index([clinicId, repoName])
  @@index([slotId])
}

// Delegated Microsoft Graph grant (Calendars.ReadWrite) for a staff member,
// so clinic events are organized from their own Outlook calendar.
model OutlookCalendarGrant {
  netId                 String   @id
  encryptedRefreshToken String
  scopes                String
  connectedAt           DateTime @default(now())
  updatedAt             DateTime @updatedAt
  lastError             String?
}
